# Kernel options applied on top of libkrunfw v5.5.0's config-libkrunfw_aarch64.
#
# Upstream ships CONFIG_SECURITY off, so the guest kernel has no Landlock and
# no securityfs. The broker demands the landlock layer on every Linux
# execution (ADR-022, D3), so this fragment turns on the three options
# Landlock needs plus the LSM list that activates it. The build script merges
# the fragment with the kernel's merge_config.sh and then lets olddefconfig
# resolve the symbols that CONFIG_SECURITY newly exposes.
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_LSM="landlock"

# A distinguishing release suffix, so that `uname -r` and /proc/version
# identify this kernel and not the stock one.
CONFIG_LOCALVERSION="-loom-landlock"
