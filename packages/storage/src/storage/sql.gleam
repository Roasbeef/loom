pub fn snapshot_recent_entries(
  before_seq before_seq: Option(Int),
  page_size page_size: Int,
) {
  let sql =
    "SELECT CAST(CASE WHEN length(CAST(id AS BLOB)) = 36 THEN id ELSE '' END AS TEXT) AS id,
  seq, length(payload) AS payload_bytes FROM entries
WHERE seq < ?1 ORDER BY seq DESC LIMIT ?2"
  #(
    sql,
    [
      dev.ParamNullable(option.map(before_seq, fn(v) { dev.ParamInt(v) })),
      dev.ParamInt(page_size),
    ],
    snapshot_recent_entries_decoder(),
  )
}

pub fn snapshot_recent_entries_decoder() -> decode.Decoder(
  SnapshotRecentEntries,
) {
  use id <- decode.field(0, decode.string)
  use seq <- decode.field(1, decode.optional(decode.int))
  use payload_bytes <- decode.field(2, decode.optional(decode.int))
  decode.success(SnapshotRecentEntries(id:, seq:, payload_bytes:))
}

pub type SnapshotEntryFragment {
  SnapshotEntryFragment(fragment: BitArray)
}

pub fn snapshot_entry_fragment(
  offset offset: Int,
  fragment_size fragment_size: Int,
  id id: String,
  seq seq: Option(Int),
  payload_bytes payload_bytes: Int,
) {
  let sql =
    "SELECT CAST(substr(payload, CAST(?1 AS INTEGER) + 1, ?2) AS BLOB) AS fragment FROM entries
WHERE id = ?3 AND seq = ?4 AND length(payload) = CAST(?5 AS INTEGER)"
  #(
    sql,
    [
      dev.ParamInt(offset),
      dev.ParamInt(fragment_size),
      dev.ParamString(id),
      dev.ParamNullable(option.map(seq, fn(v) { dev.ParamInt(v) })),
      dev.ParamInt(payload_bytes),
    ],
    snapshot_entry_fragment_decoder(),
  )
}

pub fn snapshot_entry_fragment_decoder() -> decode.Decoder(
  SnapshotEntryFragment,
) {
  use fragment <- decode.field(0, decode.bit_array)
  decode.success(SnapshotEntryFragment(fragment:))
}

pub type SnapshotEntryHead {
  SnapshotEntryHead(
    id: String,
    parent_id: Option(String),
    seq: Option(Int),
    payload_bytes: Option(Int),
  )
}

pub fn snapshot_entry_head(
  entry_id entry_id: String,
  before_seq before_seq: Option(Int),
) {
  let sql =
    "SELECT CAST(CASE WHEN length(CAST(id AS BLOB)) = 36 THEN id ELSE '' END AS TEXT) AS id,
  parent_id, seq, length(payload) AS payload_bytes FROM entries
WHERE id = ?1 AND seq < ?2 LIMIT 2"
  #(
    sql,
    [
      dev.ParamString(entry_id),
      dev.ParamNullable(option.map(before_seq, fn(v) { dev.ParamInt(v) })),
    ],
    snapshot_entry_head_decoder(),
  )
}

pub fn snapshot_entry_head_decoder() -> decode.Decoder(SnapshotEntryHead) {
  use id <- decode.field(0, decode.string)
  use parent_id <- decode.field(1, decode.optional(decode.string))
  use seq <- decode.field(2, decode.optional(decode.int))
  use payload_bytes <- decode.field(3, decode.optional(decode.int))
  decode.success(SnapshotEntryHead(id:, parent_id:, seq:, payload_bytes:))
}
