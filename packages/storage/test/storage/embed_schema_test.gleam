//// Tests for the schema embedder in `dev/embed_schema.gleam`.
////
//// The pure functions are checked on small inputs. One test then runs the
//// embedder's rules over every real schema and compares the result with the
//// committed modules, so a schema edited without `make gen-sql` fails here as
//// well as in review.

import embed_schema.{MissingSchema, NotAscii}
import gleam/list
import gleam/result
import gleam/string
import simplifile

pub fn base_schema_embeds_as_sql_schema_test() {
  assert embed_schema.module_name("schema") == "sql_schema"
}

pub fn other_schemas_keep_their_stem_test() {
  assert embed_schema.module_name("session") == "session_schema"
  assert embed_schema.module_name("catalogue_names") == "catalogue_names_schema"
}

pub fn literal_escapes_quotes_backslashes_and_newlines_test() {
  assert embed_schema.string_literal("a.sql", "a\n\"b\"\\")
    == Ok("\"a\\n\\\"b\\\"\\\\\"")
}

pub fn literal_writes_other_controls_as_codepoints_test() {
  assert embed_schema.string_literal("a.sql", "\t\r\u{1}")
    == Ok("\"\\t\\r\\u{1}\"")
}

pub fn literal_rejects_non_ascii_and_names_the_line_test() {
  assert embed_schema.string_literal("a.sql", "ok\nSELECT 'é'\n")
    == Error(NotAscii("a.sql", 2, "é"))
}

pub fn short_schema_stays_on_the_declaration_line_test() {
  let source = embed_schema.module_source("\"x\"")

  assert source
    == "//// Generated by packages/storage/dev/embed_schema.gleam. DO NOT EDIT.\n"
    <> "//// The checked-in SQL file is the schema source of truth.\n\n"
    <> "/// The schema used both at runtime and by sqlc during generation.\n"
    <> "pub const schema = \"x\"\n"
}

pub fn long_schema_moves_to_its_own_line_test() {
  let literal = "\"" <> string.repeat("x", 80) <> "\""

  assert list.contains(
    string.split(embed_schema.module_source(literal), "\n"),
    "pub const schema =",
  )
}

pub fn migrations_are_read_in_listed_order_test() {
  let source =
    "pub fn migrations() {\n"
    <> "  [\n"
    <> "    #(2, catalogue_names_schema.schema),\n"
    <> "    #(3, catalogue_archives_schema.schema),\n"
    <> "  ]\n"
    <> "}\n"
    <> "let _ = sql_schema.schema\n"

  assert embed_schema.migration_stems(source)
    == ["catalogue_names", "catalogue_archives"]
}

pub fn load_order_follows_the_rule_test() {
  let stems = ["exec_ledger", "catalogue_a", "schema", "session", "catalogue_b"]

  assert embed_schema.load_order(stems, ["catalogue_b", "catalogue_a"])
    == Ok(["schema", "catalogue_b", "catalogue_a", "session", "exec_ledger"])
}

pub fn load_order_refuses_a_migration_without_a_file_test() {
  assert embed_schema.load_order(["schema", "session"], ["catalogue_gone"])
    == Error(MissingSchema("catalogue_gone"))
}

pub fn committed_modules_match_their_schemas_test() {
  let assert Ok(names) = simplifile.read_directory("sql")
    as "the test runs from packages/storage"

  let stems =
    names
    |> list.filter(string.ends_with(_, ".sql"))
    |> list.map(string.drop_end(_, 4))

  assert stems != []

  list.each(stems, fn(stem) {
    let assert Ok(sql) = simplifile.read("sql/" <> stem <> ".sql")
      as "every schema is readable"
    let module = embed_schema.module_name(stem)
    let assert Ok(committed) =
      simplifile.read("src/storage/" <> module <> ".gleam")
      as "every schema has an embedded module"

    let rendered =
      embed_schema.string_literal(stem, sql)
      |> result.map(embed_schema.module_source)

    assert rendered == Ok(committed)
  })
}
