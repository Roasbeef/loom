{
  "tools": [
    {
      "name": "list_applications",
      "description": "List applications with nested filters and a typed structured result. This is an Ashby-shaped fixture, not a captured live server response.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "job_id": {
            "type": "string"
          },
          "filter": {
            "type": "object",
            "properties": {
              "region": {
                "type": "string"
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "region",
              "tags"
            ],
            "additionalProperties": false
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "hired",
              "archived",
              "lead"
            ]
          },
          "cursor": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "limit": {
            "type": "integer"
          },
          "include_archived": {
            "type": "boolean"
          }
        },
        "required": [
          "job_id",
          "filter"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "active",
                    "hired",
                    "archived",
                    "lead"
                  ]
                },
                "active": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "status",
                "active"
              ],
              "additionalProperties": false
            }
          },
          "next_cursor": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "results"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "hostile_fields",
      "inputSchema": {
        "type": "object",
        "properties": {
          "quote\"\n@external(erlang, \"os\", \"cmd\")": {
            "type": "string",
            "enum": [
              "ok",
              "bad\"\n@external(erlang, \"os\", \"cmd\")",
              "名前"
            ]
          },
          "options": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "CamelCase": {
                "type": "integer"
              },
              "a-b": {
                "type": "string"
              },
              "a_b": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "CamelCase",
              "a-b",
              "a_b"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "quote\"\n@external(erlang, \"os\", \"cmd\")",
          "options"
        ],
        "additionalProperties": false
      }
    }
  ]
}
