//// A private working snapshot without changing the parent's Git state.
////
//// The native caller supplies a drained, serialized and quiescent workspace.
//// Source discovery retains its Git ignore context; private metadata then
//// builds a WIP tree from final working bytes and reachable HEAD history.
//// Every Git process stays behind the broker and sandbox. The bundle is
//// verified in a fresh repository before a private child is returned.
////
//// Ordinary session jails mask the whole snapshot store. Capture can write
//// only its own stage, and a failure retains that private artifact until the
//// caller knows native custody has drained. Space preflight observes current
//// capacity; it is not a reservation against other filesystem writers.
//// This module owns local capture/import, not peer or child lifecycle custody.
////
//// The bundle is full unless the caller names a base. A base is a commit the
//// receiver reported holding (`base_candidates` lists what to ask about, and
//// `state_object.choose_basis` picks the answer), and a thin bundle then carries
//// only the commits after it. A thin bundle is verified in a fresh repository
//// that holds exactly the base and its history, which is what a receiver that
//// holds the base has. When the working tree adds nothing to `HEAD` the tip is
//// `HEAD` itself and no commit is made. Otherwise the tip is a snapshot commit.
////
//// `capture_commits` is the same capture for a finished child's work
//// (protocol-change/107, "Return"): thin against the state the child was handed,
//// with `HEAD` as the tip and the working tree unread, so only what the child
//// committed comes back and its uncommitted edits stay where they are.
////
//// ## Flow
////
//// `capture` calls `capture_against` with a full basis. `capture_against` and
//// `capture_commits` call `captured`, which calls `discover`,
//// `validate_repository`, and `selected` (`inventory`, `working_entries` and
//// `check_attributes` for working bytes, nothing for commits), then
//// `check_basis` and `check_space`.
//// It then uses `private_scope` and `update_private_index` to build a tree,
//// `tip_of` to choose the commit it delivers, `seed_base` to give a thin
//// child its base, and verifies the bundle and checks out a private child.

import broker/policy
import client/git_identity
import client/internal/ffi_os
import client/state_object
import client/worktree_git
import gleam/bit_array
import gleam/bool
import gleam/int
import gleam/list
import gleam/option.{type Option, None, Some}
import gleam/result
import gleam/set
import gleam/string
import host/bootstrap
import simplifile

/// Metadata discovered from the source repository's own Git context.
@internal
pub type Source {
  Source(
    /// The canonical working tree root.
    workspace: String,
    /// The canonical worktree-specific Git directory.
    git_dir: String,
    /// The canonical common Git directory shared by linked worktrees.
    common_dir: String,
    /// Git's object format, limited to the formats Loom can import.
    object_format: String,
    /// The source HEAD commit.
    head: String,
  )
}

/// A completed import kept inside its private staging directory.
@internal
pub type Snapshot {
  Snapshot(
    /// The private stage containing the bundle and imported tree.
    stage: String,
    /// The freshly checked out child repository.
    child: String,
    /// The commit the bundle delivers: the synthetic WIP commit when the working
    /// tree differs from `HEAD`, and `HEAD` itself when it does not.
    commit: String,
    /// The bundle file inside the stage, which `client/state_store` can admit.
    bundle: String,
    /// The commit the bundle is thin against, or `None` for a full bundle.
    base: Option(String),
    /// Whether `commit` is a snapshot of uncommitted work.
    dirty: state_object.Dirtiness,
  )
}

/// Captures a quiescent source into a fresh, private local child repository,
/// with a full bundle.
///
/// The stage name is generated by the trusted server, not a model or peer.
/// Failures retain the private stage for cleanup after processes settle.
/// The caller must serialize captures and drain workspace effects first.
///
/// ## Examples
///
/// ```gleam
/// // repository_snapshot.capture(git, source_call, store, stage_name, identity, 600_000)
/// ```
@internal
pub fn capture(
  git: worktree_git.Git,
  call: worktree_git.Capture,
  store: String,
  stage_name: String,
  identity: git_identity.Identity,
  within_ms: Int,
) -> Result(Snapshot, String) {
  capture_against(
    git,
    call,
    store,
    stage_name,
    identity,
    within_ms,
    state_object.Full,
  )
}

/// Captures a quiescent source like `capture`, bundling only what a receiver
/// that holds `basis` lacks.
///
/// With `Thin(base)` the bundle carries the commits after `base`, and its
/// header lists `base`'s boundary as prerequisites. The base must be a full
/// object id of a commit in the source's history that is an ancestor of its
/// `HEAD`; anything else is refused before a stage exists. A clean tree whose
/// `HEAD` is the base has nothing to deliver and is refused, because Git does
/// not make an empty bundle and the receiver already holds the state. The
/// child that verifies the bundle is seeded with the base and its history and
/// nothing more, so a thin bundle that needed an object the base does not
/// supply fails here and not on the receiver.
///
/// ## Examples
///
/// ```gleam
/// // repository_snapshot.capture_against(git, call, store, stage, identity, 600_000, state_object.Thin(base))
/// ```
@internal
pub fn capture_against(
  git: worktree_git.Git,
  call: worktree_git.Capture,
  store: String,
  stage_name: String,
  identity: git_identity.Identity,
  within_ms: Int,
  basis: state_object.Basis,
) -> Result(Snapshot, String) {
  captured(
    git,
    call,
    store,
    stage_name,
    identity,
    within_ms,
    basis,
    WorkingBytes,
  )
}

/// What a capture puts on top of the repository's history.
type Content {
  /// The working tree's bytes, as a snapshot commit when they differ from
  /// `HEAD`. This is what a parent's workspace is sent as.
  WorkingBytes

  /// Nothing: the tip is `HEAD` and the working tree is not read. This is what a
  /// finished child's work is returned as, because only what it committed comes
  /// back.
  CommittedOnly
}

/// Captures the commits a repository has made after `base`, and nothing the
/// working tree holds (protocol-change/107, "Return").
///
/// This is the capture of a finished child's work: the bundle is thin against the
/// state the child was handed, its tip is `HEAD`, and edits the child left
/// uncommitted, staged or untracked do not travel. The working tree is neither
/// inventoried nor read, so a build directory or a file the child left behind
/// cannot make the capture fail, and no author identity is needed because no
/// commit is made. `directory` must be the top of a primary checkout whose `.git`
/// is the directory under it: a repository that resolves anywhere else, such as
/// one reached through a link the child planted, is refused. `Ok(None)` says
/// `HEAD` is `base` itself, so there is nothing to return. A `base` that is not
/// an ancestor of `HEAD` is refused, which is what a child that rewrote the
/// history it was given earns.
///
/// ## Examples
///
/// ```gleam
/// // repository_snapshot.capture_commits(git, call, store, stage, 600_000, sent_tip)
/// ```
@internal
pub fn capture_commits(
  git: worktree_git.Git,
  call: worktree_git.Capture,
  store: String,
  stage_name: String,
  within_ms: Int,
  base: String,
) -> Result(Option(Snapshot), String) {
  use source <- result.try(discover(git, call, within_ms))

  // The repository must be the one at the directory, not one it points at.
  use Nil <- result.try(
    case
      source.workspace == call.directory
      && source.git_dir == source.workspace <> "/.git"
      && source.common_dir == source.git_dir
    {
      True -> Ok(Nil)
      False ->
        Error("the repository is not a primary checkout at its directory")
    },
  )

  // A child that committed nothing has nothing to bundle.
  use <- bool.guard(when: source.head == base, return: Ok(None))
  captured(
    git,
    call,
    store,
    stage_name,
    git_identity.Identity(None, None),
    within_ms,
    state_object.Thin(base),
    CommittedOnly,
  )
  |> result.map(Some)
}

/// The capture both entry points run, differing only in what is put on top of
/// `HEAD`.
fn captured(
  git: worktree_git.Git,
  call: worktree_git.Capture,
  store: String,
  stage_name: String,
  identity: git_identity.Identity,
  within_ms: Int,
  basis: state_object.Basis,
  content: Content,
) -> Result(Snapshot, String) {
  let deadline = bootstrap.monotonic_time_ms() + within_ms
  let limits = call.limits

  // Bound every Git subprocess, even when a caller offers wider limits.
  use Nil <- result.try(
    case
      within_ms > 0
      && limits.cpu_s > 0
      && limits.wall_s > 0
      && limits.mem_bytes > 0
      && limits.pids > 0
      && limits.fsize_bytes > 0
      && limits.output_bytes > 0
    {
      True -> Ok(Nil)
      False -> Error("invalid snapshot resource bounds")
    },
  )

  let call =
    worktree_git.Capture(
      ..call,
      scope: readable_authority(call.scope),
      limits: policy.Limits(
        cpu_s: int.min(limits.cpu_s, 300),
        wall_s: int.min(limits.wall_s, 600),
        mem_bytes: int.min(limits.mem_bytes, 2_147_483_648),
        pids: int.min(limits.pids, 64),
        fsize_bytes: int.min(limits.fsize_bytes, 1_073_741_824),
        output_bytes: int.min(limits.output_bytes, 1_048_576),
      ),
    )
  use _ <- result.try(validate_path(stage_name))

  // One generated component keeps the stage under its established store.
  use Nil <- result.try(case string.contains(stage_name, "/") {
    True -> Error("invalid snapshot stage name")
    False -> Ok(Nil)
  })

  // Only the daemon's masked store may receive a new stage.
  use Nil <- result.try(case list.contains(call.scope.protected, store) {
    True -> Ok(Nil)
    False -> Error("snapshot store is not protected by the parent policy")
  })

  // Discovery's writable scratch must not reach source or protected data.
  use scratch <- result.try(bootstrap.canonical_directory(call.staging))

  // A writable scratch grant must not shadow any existing protected region.
  use Nil <- result.try(
    case
      scratch == call.staging
      && !overlaps(scratch, call.directory)
      && !list.any(call.scope.protected, fn(mask) { overlaps(scratch, mask) })
    {
      True -> Ok(Nil)
      False -> Error("snapshot discovery scratch overlaps protected data")
    },
  )

  use source <- result.try(discover(git, call, remaining(deadline)))

  // A linked worktree can keep its metadata outside the workspace.
  use Nil <- result.try(
    case
      !overlaps(scratch, source.git_dir)
      && !overlaps(scratch, source.common_dir)
    {
      True -> Ok(Nil)
      False -> Error("snapshot discovery scratch overlaps Git metadata")
    },
  )

  use Nil <- result.try(refuse_grafts(source.common_dir, call.scope.protected))
  use Nil <- result.try(validate_repository(git, call, deadline))
  use #(working, paths) <- result.try(selected(
    git,
    call,
    source,
    content,
    deadline,
  ))

  // A thin base is judged in the source context, before any stage exists.
  use Nil <- result.try(check_basis(git, call, source.head, basis, deadline))

  // The history estimate and working bytes are observations, not a quota.
  use history <- result.try(git_text(
    git,
    worktree_git.Capture(
      ..call,
      arguments: [
        "rev-list", "--disk-usage", "--objects", "--missing=error", source.head,
      ],
      context: worktree_git.SourceContext,
      stdin: <<>>,
    ),
    deadline,
  ))
  use history_bytes <- result.try(
    int.parse(string.trim(history))
    |> result.replace_error("repository history size is unavailable"),
  )

  // The host query has a five-second deadline of its own.
  use Nil <- result.try(case history_bytes >= 0 && remaining(deadline) >= 5000 {
    True -> Ok(Nil)
    False -> Error("snapshot deadline or history estimate is invalid")
  })

  use Nil <- result.try(check_space(
    store,
    history_bytes * 4 + working.bytes * 4 + 536_870_912,
  ))

  // Exclusive creation leaves any failed artifact inside the masked store.
  let stage = store <> "/" <> stage_name
  use Nil <- result.try(
    simplifile.create_directory(stage)
    |> result.replace_error(
      "snapshot stage already exists or cannot be created",
    ),
  )
  use Nil <- result.try(bootstrap.ensure_private_directory(stage))
  use scope <- result.try(private_scope(
    call.scope,
    source.workspace,
    source.git_dir,
    source.common_dir,
    store,
    stage,
  ))
  let scoped =
    worktree_git.Capture(
      ..call,
      scope:,
      staging: stage,
      directory: stage,
      context: worktree_git.SourceContext,
      stdin: <<>>,
    )
  let private_git = stage <> "/source.git"
  let child = stage <> "/child"
  let bundle = stage <> "/snapshot.bundle"
  use _ <- result.try(git_text(
    git,
    worktree_git.Capture(..scoped, arguments: [
      "init",
      "--bare",
      "--object-format=" <> source.object_format,
      private_git,
    ]),
    deadline,
  ))
  let private =
    worktree_git.Capture(
      ..scoped,
      directory: source.workspace,
      context: worktree_git.PrivateContext(
        git_dir: private_git,
        index_file: stage <> "/index",
        object_directory: private_git <> "/objects",
        alternate_object_directories: [source.common_dir <> "/objects"],
      ),
    )
  use _ <- result.try(private_git_text(
    git,
    private,
    ["read-tree", source.head],
    <<>>,
    deadline,
  ))
  use Nil <- result.try(attributes_in(git, private, paths, remaining(deadline)))

  // Remove deleted paths and stage final working bytes into the private index.
  use Nil <- result.try(update_private_index(git, private, working, deadline))
  use tree <- result.try(private_git_text(
    git,
    private,
    ["write-tree"],
    <<>>,
    deadline,
  ))
  use #(commit, dirty) <- result.try(tip_of(
    git,
    private,
    source.head,
    string.trim(tree),
    identity,
    deadline,
  ))
  use Nil <- result.try(refuse_empty_thin(commit, basis))

  use _ <- result.try(private_git_text(
    git,
    private,
    ["update-ref", state_object.bundle_ref, commit],
    <<>>,
    deadline,
  ))
  use Nil <- result.try(index_matches_tree(git, private, content, deadline))
  use _ <- result.try(private_git_text(
    git,
    private,
    list.append(
      ["bundle", "create", bundle, state_object.bundle_ref],
      exclusions(basis),
    ),
    <<>>,
    deadline,
  ))

  // Verify and import only into a fresh repository inside the private stage.
  use _ <- result.try(git_text(
    git,
    worktree_git.Capture(..scoped, arguments: [
      "init",
      "--object-format=" <> source.object_format,
      child,
    ]),
    deadline,
  ))
  let target = worktree_git.Capture(..scoped, directory: child)
  use Nil <- result.try(seed_base(git, private, target, stage, basis, deadline))
  use _ <- result.try(target_git_text(
    git,
    target,
    ["bundle", "verify", bundle],
    deadline,
  ))
  use _ <- result.try(target_git_text(
    git,
    target,
    ["fetch", bundle, state_object.bundle_ref <> ":" <> state_object.bundle_ref],
    deadline,
  ))
  use _ <- result.try(target_git_text(
    git,
    target,
    ["checkout", "--detach", commit],
    deadline,
  ))
  use status <- result.try(target_git_text(
    git,
    target,
    ["status", "--porcelain=v1", "-z", "--untracked-files=all"],
    deadline,
  ))

  // A dirty or late checkout cannot become the imported child.
  case status == "", remaining(deadline) > 0 {
    True, True ->
      Ok(Snapshot(
        stage:,
        child:,
        commit:,
        bundle:,
        base: basis_base(basis),
        dirty:,
      ))
    False, _ -> Error("imported snapshot is not clean")
    True, False -> Error("snapshot capture deadline expired")
  }
}

/// What the capture reads of the working tree: the entries a snapshot commit is
/// built from and the paths whose attributes are checked. A capture of commits
/// reads none, and an empty selection makes every later step that takes one do
/// nothing.
fn selected(
  git: worktree_git.Git,
  call: worktree_git.Capture,
  source: Source,
  content: Content,
  deadline: Int,
) -> Result(#(WorkingEntries, List(String)), String) {
  // Only the working bytes need the inventory, the size accounting and the
  // attribute check.
  case content {
    CommittedOnly -> Ok(#(WorkingEntries([], [], 0), []))
    WorkingBytes -> {
      use entries <- result.try(inventory(git, call, remaining(deadline)))
      use working <- result.try(working_entries(
        source.workspace,
        call.scope,
        entries,
      ))
      let paths = list.append(entries.tracked, entries.untracked) |> list.unique
      use Nil <- result.map(check_attributes(
        git,
        call,
        paths,
        remaining(deadline),
      ))
      #(working, paths)
    }
  }
}

/// Proves the private index is the tree the working bytes were collected into: a
/// snapshot of the working tree must leave nothing the index lacks. A capture of
/// commits has no such claim, because its index is `HEAD`'s tree and the working
/// tree is free to differ from it.
fn index_matches_tree(
  git: worktree_git.Git,
  private: worktree_git.Capture,
  content: Content,
  deadline: Int,
) -> Result(Nil, String) {
  // The comparison would fail by design for a child's uncommitted edits.
  case content {
    CommittedOnly -> Ok(Nil)
    WorkingBytes ->
      private_git_text(
        git,
        private,
        ["diff-files", "--quiet", "--no-ext-diff"],
        <<>>,
        deadline,
      )
      |> result.replace(Nil)
  }
}

/// Lists the commits a sender can offer a receiver as the base of a thin
/// bundle, newest first: `HEAD` and its first-parent chain to
/// `state_object.candidate_limit` commits, then the merge base with the
/// upstream branch when one is configured and has one.
///
/// The receiver answers with the ones it holds, and
/// `state_object.choose_basis` turns that answer into the basis to capture
/// against. A repository with no upstream simply offers the chain.
///
/// ## Examples
///
/// ```gleam
/// // repository_snapshot.base_candidates(git, discovery_call, 30_000)
/// ```
@internal
pub fn base_candidates(
  git: worktree_git.Git,
  call: worktree_git.Capture,
  within_ms: Int,
) -> Result(List(String), String) {
  let deadline = bootstrap.monotonic_time_ms() + within_ms
  let source =
    worktree_git.Capture(
      ..call,
      context: worktree_git.SourceContext,
      stdin: <<>>,
    )
  use chain <- result.try(git_text(
    git,
    worktree_git.Capture(..source, arguments: [
      "rev-list",
      "--first-parent",
      "--max-count=" <> int.to_string(state_object.candidate_limit),
      "HEAD",
    ]),
    deadline,
  ))
  use chain <- result.try(
    string.split(string.trim(chain), "\n")
    |> list.try_map(fn(line) {
      case state_object.is_object_id(line) {
        True -> Ok(line)
        False -> Error("repository history is not a list of commits")
      }
    }),
  )
  use merged <- result.map(upstream_base(git, source, deadline))

  // The merge base is usually in the chain already, and is listed once.
  case merged {
    Some(upstream) -> list.unique(list.append(chain, [upstream]))
    None -> chain
  }
}

/// The merge base of `HEAD` and its upstream branch, or `None` when the branch
/// has no upstream or the two share no history. Git reports both by exit code,
/// which `git_output` would turn into an error, so the code is read here.
fn upstream_base(
  git: worktree_git.Git,
  source: worktree_git.Capture,
  deadline: Int,
) -> Result(Option(String), String) {
  use output <- result.try(git_capture(
    git,
    worktree_git.Capture(..source, arguments: [
      "merge-base",
      "HEAD",
      "@{upstream}",
    ]),
    deadline,
  ))

  // A nonzero exit is the absence of an answer. A zero exit must be a commit.
  use <- bool.guard(when: output.code != 0, return: Ok(None))
  use text <- result.try(
    bit_array.to_string(output.stdout)
    |> result.replace_error("repository metadata is not UTF-8"),
  )
  let merged = string.trim(text)
  use <- bool.guard(
    when: !state_object.is_object_id(merged),
    return: Error("the upstream merge base is not a commit"),
  )
  Ok(Some(merged))
}

/// Refuses a thin base the source cannot bundle against. It must be a full
/// object id that names a commit and is an ancestor of `HEAD`, so that "the
/// commits after the base" means `base..HEAD` and the snapshot commit.
fn check_basis(
  git: worktree_git.Git,
  call: worktree_git.Capture,
  head: String,
  basis: state_object.Basis,
  deadline: Int,
) -> Result(Nil, String) {
  // A full bundle names no base, so there is nothing to check.
  case basis {
    state_object.Full -> Ok(Nil)
    state_object.Thin(base) -> check_thin(git, call, head, base, deadline)
  }
}

/// The checks on a thin base, run in the source context.
fn check_thin(
  git: worktree_git.Git,
  call: worktree_git.Capture,
  head: String,
  base: String,
  deadline: Int,
) -> Result(Nil, String) {
  use <- bool.guard(
    when: !state_object.is_object_id(base),
    return: Error("the thin base is not a full object id"),
  )
  let source =
    worktree_git.Capture(
      ..call,
      context: worktree_git.SourceContext,
      stdin: <<>>,
    )
  use resolved <- result.try(
    git_text(
      git,
      worktree_git.Capture(..source, arguments: [
        "rev-parse",
        "--verify",
        base <> "^{commit}",
      ]),
      deadline,
    )
    |> result.replace_error(
      "the thin base is not a commit in the source repository",
    ),
  )

  // A merge base equal to the base is how Git says it is an ancestor.
  use merged <- result.try(
    git_text(
      git,
      worktree_git.Capture(..source, arguments: ["merge-base", base, head]),
      deadline,
    )
    |> result.replace_error("the thin base shares no history with HEAD"),
  )
  use <- bool.guard(
    when: string.trim(resolved) != base || string.trim(merged) != base,
    return: Error("the thin base is not an ancestor of the source HEAD"),
  )
  Ok(Nil)
}

/// Refuses a capture with nothing to deliver. A clean tree has `HEAD` as its
/// tip, so a base equal to it leaves an empty bundle, which Git will not make.
/// The receiver already holds the state, so there is nothing to send.
fn refuse_empty_thin(
  tip: String,
  basis: state_object.Basis,
) -> Result(Nil, String) {
  case basis {
    state_object.Thin(base) if base == tip ->
      Error(
        "the receiver already holds the clean tip, so there is nothing to bundle",
      )
    state_object.Thin(_) | state_object.Full -> Ok(Nil)
  }
}

/// The revision arguments that make a bundle thin: the base, excluded, which
/// Git records as the bundle's prerequisites.
fn exclusions(basis: state_object.Basis) -> List(String) {
  case basis {
    state_object.Full -> []
    state_object.Thin(base) -> ["^" <> base]
  }
}

/// The base a basis names, as the state description spells it.
fn basis_base(basis: state_object.Basis) -> Option(String) {
  case basis {
    state_object.Full -> None
    state_object.Thin(base) -> Some(base)
  }
}

/// Chooses the commit the bundle delivers. A working tree whose tree object is
/// `HEAD`'s adds nothing, so `HEAD` is the tip and no commit is made, which also
/// means a clean capture needs no author identity. Any difference makes a
/// snapshot commit on top of `HEAD`.
fn tip_of(
  git: worktree_git.Git,
  private: worktree_git.Capture,
  head: String,
  tree: String,
  identity: git_identity.Identity,
  deadline: Int,
) -> Result(#(String, state_object.Dirtiness), String) {
  use head_tree <- result.try(private_git_text(
    git,
    private,
    ["rev-parse", head <> "^{tree}"],
    <<>>,
    deadline,
  ))

  // Equal tree objects mean the working bytes add nothing to `HEAD`.
  case string.trim(head_tree) == tree {
    True -> Ok(#(head, state_object.Clean))
    False -> {
      use commit <- result.map(wip_commit(
        git,
        private,
        head,
        tree,
        identity,
        deadline,
      ))
      #(commit, state_object.Dirty)
    }
  }
}

/// Writes the snapshot commit for a tree on top of `HEAD`, into the private
/// object store only.
fn wip_commit(
  git: worktree_git.Git,
  private: worktree_git.Capture,
  head: String,
  tree: String,
  identity: git_identity.Identity,
  deadline: Int,
) -> Result(String, String) {
  let committed =
    private_git_text(
      git,
      private,
      list.append(identity_arguments(identity), [
        "commit-tree",
        tree,
        "-p",
        head,
        "-m",
        "Working snapshot",
      ]),
      <<>>,
      deadline,
    )

  // Keep missing identity explicit without inventing an author or host email.
  use commit <- result.map(case committed, identity.name, identity.email {
    Error(_), None, _ | Error(_), _, None ->
      Error(
        "Git could not create the WIP commit; user.name and user.email are incomplete",
      )
    result, _, _ -> result
  })

  string.trim(commit)
}

/// Gives the verification child the base and its history, and nothing else.
///
/// A receiver that holds the base holds its ancestry and no object beyond what
/// the base reaches, so the child is built to match: a bundle of the base alone
/// is made in the private repository and fetched into the child. Verifying the
/// thin bundle there proves it needs nothing the base does not supply, which a
/// child that shared the source's object store could never prove.
fn seed_base(
  git: worktree_git.Git,
  private: worktree_git.Capture,
  target: worktree_git.Capture,
  stage: String,
  basis: state_object.Basis,
  deadline: Int,
) -> Result(Nil, String) {
  // A full bundle needs nothing from the receiver, so the child starts empty.
  case basis {
    state_object.Full -> Ok(Nil)
    state_object.Thin(base) -> {
      let seed = stage <> "/base.bundle"
      use _ <- result.try(private_git_text(
        git,
        private,
        ["update-ref", "refs/loom/base", base],
        <<>>,
        deadline,
      ))
      use _ <- result.try(private_git_text(
        git,
        private,
        ["bundle", "create", seed, "refs/loom/base"],
        <<>>,
        deadline,
      ))
      use _ <- result.map(target_git_text(
        git,
        target,
        ["fetch", seed, "refs/loom/base:refs/loom/base"],
        deadline,
      ))
      Nil
    }
  }
}

/// Refuses grafts, which change ancestry independently of replacement refs.
fn refuse_grafts(
  common_dir: String,
  protected: List(String),
) -> Result(Nil, String) {
  let info = common_dir <> "/info"
  let grafts = info <> "/grafts"

  // A masked graft path cannot establish that the original ancestry is intact.
  use Nil <- result.try(
    case
      list.any(protected, fn(mask) { policy.covers(root: mask, path: grafts) })
    {
      True -> Error("repository graft state is protected")
      False -> Ok(Nil)
    },
  )

  // Never follow a redirected info directory to inspect an external graft file.
  case simplifile.link_info(info) {
    Error(simplifile.Enoent) -> Ok(Nil)
    Error(_) -> Error("repository graft state is unavailable")
    Ok(entry) ->
      case simplifile.file_info_type(entry) {
        simplifile.Directory ->
          case simplifile.link_info(grafts) {
            Error(simplifile.Enoent) -> Ok(Nil)
            Error(_) -> Error("repository graft state is unavailable")
            Ok(_) -> Error("Git grafts are unsupported")
          }
        _ -> Error("repository Git info directory is not a directory")
      }
  }
}

/// Converts existing read-write and mount grants to read-only discovery roots.
fn readable_authority(scope: policy.SandboxPolicy) -> policy.SandboxPolicy {
  let roots =
    list.flatten([
      scope.readable_roots,
      scope.writable_roots,
      list.map(scope.mounts, fn(mount) { mount.path }),
    ])
    |> list.unique
  policy.SandboxPolicy(..scope, readable_roots: roots)
}

/// Refuses source repositories whose complete working state is unavailable.
fn validate_repository(
  git: worktree_git.Git,
  call: worktree_git.Capture,
  deadline: Int,
) -> Result(Nil, String) {
  let source =
    worktree_git.Capture(
      ..call,
      context: worktree_git.SourceContext,
      stdin: <<>>,
    )
  use shallow <- result.try(git_text(
    git,
    worktree_git.Capture(..source, arguments: [
      "rev-parse",
      "--is-shallow-repository",
    ]),
    deadline,
  ))

  // Shallow history cannot satisfy the full ancestry contract.
  use Nil <- result.try(case string.trim(shallow) {
    "false" -> Ok(Nil)
    "true" -> Error("shallow Git repositories are unsupported")
    _ -> Error("repository history completeness is unknown")
  })

  use flags <- result.try(git_text(
    git,
    worktree_git.Capture(..source, arguments: ["ls-files", "-v", "-z"]),
    deadline,
  ))
  use flags <- result.try(nul_fields(flags))

  // Skip-worktree entries are not evidence of complete working content.
  case
    list.any(flags, fn(flag) {
      string.starts_with(flag, "S ") || string.starts_with(flag, "s ")
    })
  {
    True -> Error("sparse Git repositories are unsupported")
    False -> Ok(Nil)
  }
}

/// Refuses partial or sparse configuration before resolving the HEAD object.
fn refuse_partial_configuration(
  git: worktree_git.Git,
  source: worktree_git.Capture,
  deadline: Int,
) -> Result(Nil, String) {
  use config <- result.try(worktree_git.run_capture(
    git,
    worktree_git.Capture(..source, arguments: [
      "--no-replace-objects", "-c", "core.fsmonitor=false", "-c",
      "core.hooksPath=/dev/null", "config", "--includes", "--get-regexp",
      "^(extensions\\.partialclone|remote\\..*\\.promisor|core\\.sparsecheckout|index\\.sparse)$",
    ]),
    remaining(deadline),
  ))

  // Git config exits one only when none of the unsupported keys exists.
  case config.code {
    1 -> Ok(Nil)
    0 -> Error("partial or sparse Git repositories are unsupported")
    _ -> Error("repository completeness configuration is unavailable")
  }
}

fn remaining(deadline: Int) -> Int {
  deadline - bootstrap.monotonic_time_ms()
}

/// Carries only the supplied owner identity into the private commit.
fn identity_arguments(identity: git_identity.Identity) -> List(String) {
  // Missing name is left for Git's configured-identity refusal.
  let name = case identity.name {
    Some(value) -> ["-c", "user.name=" <> value]
    None -> []
  }

  // Missing email is likewise never replaced with a host-derived value.
  let email = case identity.email {
    Some(value) -> ["-c", "user.email=" <> value]
    None -> []
  }

  list.append(name, email)
}

/// Applies fixed safety configuration to every private Git operation.
fn private_git_text(
  git: worktree_git.Git,
  call: worktree_git.Capture,
  arguments: List(String),
  input: BitArray,
  deadline: Int,
) -> Result(String, String) {
  git_text(
    git,
    worktree_git.Capture(
      ..call,
      arguments: [
        "--literal-pathspecs",
        "-c",
        "core.autocrlf=false",
        "-c",
        "core.hooksPath=/dev/null",
        "-c",
        "user.useConfigOnly=true",
        "--work-tree=" <> call.directory,
        ..arguments
      ],
      stdin: input,
    ),
    deadline,
  )
}

/// Applies fixed configuration to Git operations in the fresh child.
fn target_git_text(
  git: worktree_git.Git,
  call: worktree_git.Capture,
  arguments: List(String),
  deadline: Int,
) -> Result(String, String) {
  git_text(
    git,
    worktree_git.Capture(..call, arguments: [
      "-c",
      "core.autocrlf=false",
      "-c",
      "core.hooksPath=/dev/null",
      "-c",
      "protocol.file.allow=always",
      ..arguments
    ]),
    deadline,
  )
}

/// Updates only the generated index from the admitted path sets.
fn update_private_index(
  git: worktree_git.Git,
  call: worktree_git.Capture,
  working: WorkingEntries,
  deadline: Int,
) -> Result(Nil, String) {
  // Delete absent paths from the generated index first.
  use Nil <- result.try(index_batches(
    git,
    call,
    working.removed,
    ["update-index", "--force-remove", "-z", "--stdin"],
    deadline,
  ))

  // The remaining entries are added from their final working bytes.
  index_batches(
    git,
    call,
    working.present,
    ["add", "--all", "--force", "--pathspec-from-file=-", "--pathspec-file-nul"],
    deadline,
  )
}

/// Sends bounded path frames without extending the capture deadline.
fn index_batches(
  git: worktree_git.Git,
  call: worktree_git.Capture,
  paths: List(String),
  arguments: List(String),
  deadline: Int,
) -> Result(Nil, String) {
  // Every batch must settle before the next index update begins.
  case paths {
    [] -> Ok(Nil)
    _ -> {
      let #(batch, rest) = list.split(paths, at: 64)
      use _ <- result.try(private_git_text(
        git,
        call,
        arguments,
        nul_input(batch),
        deadline,
      ))
      index_batches(git, call, rest, arguments, deadline)
    }
  }
}

fn nul_input(paths: List(String)) -> BitArray {
  bit_array.from_string(string.join(paths, "\u{0}") <> "\u{0}")
}

/// Source-context paths selected before any private Git index is substituted.
@internal
pub type Inventory {
  Inventory(
    /// HEAD and real-index paths, including ignored staged additions.
    tracked: List(String),
    /// Nonignored untracked paths outside Loom's runtime directory.
    untracked: List(String),
  )
}

/// Working entries admitted for a private tree and their total logical bytes.
@internal
pub type WorkingEntries {
  WorkingEntries(
    /// Selected paths that currently name regular files or symlinks.
    present: List(String),
    /// Tracked paths no longer present in the working tree.
    removed: List(String),
    /// Sum of file lengths and symlink text lengths.
    bytes: Int,
  )
}

/// Accounts for selected working bytes without following any symlink.
///
/// Parent directories are inspected one component at a time before the final
/// entry, so a symlink cannot redirect host reads outside the workspace. A
/// selected file over one GiB, or more than sixteen GiB in total, is refused.
/// The resulting count is an input to disk preflight, not a disk reservation.
///
/// ## Examples
///
/// ```gleam
/// // repository_snapshot.working_entries(source.workspace, scope, inventory)
/// ```
@internal
pub fn working_entries(
  workspace: String,
  scope: policy.SandboxPolicy,
  inventory: Inventory,
) -> Result(WorkingEntries, String) {
  use Nil <- result.try(private_source_paths(scope, workspace, [workspace]))
  let paths = list.unique(list.append(inventory.tracked, inventory.untracked))
  let tracked = set.from_list(inventory.tracked)
  use entries <- result.try(
    list.try_fold(paths, WorkingEntries([], [], 0), fn(entries, path) {
      use _ <- result.try(validate_path(path))
      use size <- result.try(inspect_components(
        workspace,
        string.split(path, "/"),
        scope.protected,
      ))

      // Missing tracked paths become removals in the private index.
      case size {
        Missing ->
          case set.contains(tracked, path) {
            True ->
              Ok(WorkingEntries(..entries, removed: [path, ..entries.removed]))
            False ->
              Error("untracked repository path disappeared during capture")
          }
        Present(bytes) ->
          case
            bytes >= 0
            && bytes <= 1_073_741_824
            && entries.bytes + bytes <= 17_179_869_184
          {
            True ->
              Ok(WorkingEntries(
                present: [path, ..entries.present],
                removed: entries.removed,
                bytes: entries.bytes + bytes,
              ))
            False -> Error("repository working bytes exceed the snapshot limit")
          }
      }
    }),
  )
  Ok(
    WorkingEntries(
      ..entries,
      present: list.reverse(entries.present),
      removed: list.reverse(entries.removed),
    ),
  )
}

type PathSize {
  Missing
  Present(Int)
}

/// Walks each parent with lstat semantics; symlinks are never traversed.
fn inspect_components(
  parent: String,
  components: List(String),
  protected: List(String),
) -> Result(PathSize, String) {
  // Each component must remain inside the selected workspace.
  case components {
    [] -> Error("invalid repository inventory path")
    [name, ..rest] -> {
      let path = parent <> "/" <> name

      // A protected entry is neither read nor silently left out.
      use Nil <- result.try(
        case
          list.any(protected, fn(mask) { policy.covers(root: mask, path:) })
        {
          True -> Error("repository path overlaps protected state")
          False -> Ok(Nil)
        },
      )

      // A missing ancestor or non-directory means the old tracked path is gone.
      case simplifile.link_info(path) {
        Error(simplifile.Enoent) | Error(simplifile.Enotdir) -> Ok(Missing)
        Error(_) -> Error("repository path cannot be inspected")
        Ok(info) ->
          case rest, simplifile.file_info_type(info) {
            [], simplifile.File -> {
              use Nil <- result.try(refuse_lfs_pointer(path))
              Ok(Present(info.size))
            }
            [], simplifile.Symlink -> Ok(Present(info.size))
            [], simplifile.Directory -> Ok(Missing)
            [], simplifile.Other -> Error("unsupported repository file type")
            _, simplifile.Directory -> inspect_components(path, rest, protected)
            _, simplifile.File | _, simplifile.Symlink -> Ok(Missing)
            _, simplifile.Other -> Error("unsupported repository file type")
          }
      }
    }
  }
}

/// Inspects only the fixed header, after the component walk excludes symlinks.
fn refuse_lfs_pointer(path: String) -> Result(Nil, String) {
  let header = "version https://git-lfs.github.com/spec/v1"
  use prefix <- result.try(
    bootstrap.read_prefix(path, string.byte_size(header))
    |> result.replace_error("repository file prefix cannot be read"),
  )

  // A pointer cannot stand in for the external content it names.
  case prefix == bit_array.from_string(header) {
    True -> Error("repository contains a Git LFS pointer")
    False -> Ok(Nil)
  }
}

/// Inventories the source HEAD, real index and eligible untracked paths.
///
/// The source must remain quiescent through capture. Submodules, unmerged
/// entries, malformed paths, non-UTF-8 output and excessive inventories fail.
/// This alone does not validate transformations or complete Git history.
///
/// ## Examples
///
/// ```gleam
/// // repository_snapshot.inventory(git, discovery_call, 30_000)
/// ```
@internal
pub fn inventory(
  git: worktree_git.Git,
  call: worktree_git.Capture,
  within_ms: Int,
) -> Result(Inventory, String) {
  let deadline = bootstrap.monotonic_time_ms() + within_ms
  let source =
    worktree_git.Capture(
      ..call,
      context: worktree_git.SourceContext,
      stdin: <<>>,
    )

  // Read HEAD and index independently: staged deletions can be recreated.
  use tree <- result.try(git_text(
    git,
    worktree_git.Capture(..source, arguments: ["ls-tree", "-rz", "HEAD"]),
    deadline,
  ))
  use head_paths <- result.try(entries(tree, TreeEntries))
  use index <- result.try(git_text(
    git,
    worktree_git.Capture(..source, arguments: ["ls-files", "--stage", "-z"]),
    deadline,
  ))
  use index_paths <- result.try(entries(index, IndexEntries))

  // Bound the union before deduplication allocates its result.
  use Nil <- result.try(
    case list.length(head_paths) + list.length(index_paths) <= 40_000 {
      True -> Ok(Nil)
      False -> Error("repository inventory exceeds the path limit")
    },
  )

  let tracked = list.unique(list.append(head_paths, index_paths))

  // Source ignore rules apply only to the untracked half of the union.
  use others <- result.try(untracked_text(
    git,
    worktree_git.Capture(..source, arguments: [
      "ls-files", "--others", "--exclude-standard", "-z",
    ]),
    deadline,
  ))
  use untracked <- result.try(paths_from_nul(others))

  // Tracked runtime bytes cannot be omitted without changing the tree.
  use Nil <- result.try(case list.any(tracked, runtime_path) {
    True -> Error("tracked repository path overlaps Loom runtime data")
    False -> Ok(Nil)
  })

  let untracked = list.filter(untracked, fn(path) { !runtime_path(path) })

  // Bound the complete working set before any file is admitted.
  case list.length(tracked) + list.length(untracked) <= 20_000 {
    True -> Ok(Inventory(tracked:, untracked:))
    False -> Error("repository inventory exceeds the path limit")
  }
}

/// Refuses effective attributes that can transform working bytes.
///
/// Attribute lookup runs in the source context, including its info attributes.
/// The private Git commands must separately force `core.autocrlf=false` and
/// disable hooks, external drivers and global or system configuration.
///
/// ## Examples
///
/// ```gleam
/// // repository_snapshot.check_attributes(git, discovery_call, paths, 30_000)
/// ```
@internal
pub fn check_attributes(
  git: worktree_git.Git,
  call: worktree_git.Capture,
  paths: List(String),
  within_ms: Int,
) -> Result(Nil, String) {
  attributes_in(
    git,
    worktree_git.Capture(..call, context: worktree_git.SourceContext),
    paths,
    within_ms,
  )
}

/// Checks attributes in the Git context selected by the trusted caller.
fn attributes_in(
  git: worktree_git.Git,
  call: worktree_git.Capture,
  paths: List(String),
  within_ms: Int,
) -> Result(Nil, String) {
  attribute_batches(git, call, paths, bootstrap.monotonic_time_ms() + within_ms)
}

/// Keeps attribute streams bounded while retaining one overall deadline.
fn attribute_batches(
  git: worktree_git.Git,
  call: worktree_git.Capture,
  paths: List(String),
  deadline: Int,
) -> Result(Nil, String) {
  // An empty inventory has no attributes to query.
  case paths {
    [] -> Ok(Nil)
    _ -> {
      let #(batch, rest) = list.split(paths, at: 32)
      let input = string.join(batch, "\u{0}") <> "\u{0}"

      // The runner accepts at most one bounded stdin frame.
      use Nil <- result.try(case string.byte_size(input) <= 1_048_576 {
        True -> Ok(Nil)
        False -> Error("repository attribute input exceeds the limit")
      })

      let query =
        worktree_git.Capture(
          ..call,
          arguments: list.append(
            context_arguments(call.context, call.directory),
            [
              "check-attr", "-z", "--stdin", "filter", "text", "eol", "ident",
              "crlf", "working-tree-encoding",
            ],
          ),
          stdin: bit_array.from_string(input),
        )
      use response <- result.try(git_text(git, query, deadline))
      use records <- result.try(nul_fields(response))
      use Nil <- result.try(check_attribute_records(batch, records))
      attribute_batches(git, call, rest, deadline)
    }
  }
}

/// Selects the source working tree when a private Git directory is active.
fn context_arguments(
  context: worktree_git.CaptureContext,
  workspace: String,
) -> List(String) {
  case context {
    worktree_git.SourceContext -> []
    worktree_git.PrivateContext(..) -> ["--work-tree=" <> workspace]
  }
}

/// Verifies each returned attribute against its requested path and name.
fn check_attribute_records(
  paths: List(String),
  records: List(String),
) -> Result(Nil, String) {
  let expected =
    list.flat_map(paths, fn(path) {
      list.map(
        ["filter", "text", "eol", "ident", "crlf", "working-tree-encoding"],
        fn(name) { #(path, name) },
      )
    })
  attribute_pairs(expected, records)
}

/// Consumes complete path/name/value triples without accepting omissions.
fn attribute_pairs(
  expected: List(#(String, String)),
  records: List(String),
) -> Result(Nil, String) {
  case expected, records {
    [], [] -> Ok(Nil)
    [#(wanted_path, wanted_name), ..remaining], [path, name, value, ..rest]
      if wanted_path == path && wanted_name == name
    ->
      case value == "unspecified" || value == "unset" {
        True -> attribute_pairs(remaining, rest)
        False -> Error("repository path has a content transformation")
      }
    _, _ -> Error("malformed repository attribute response")
  }
}

type EntryKind {
  TreeEntries
  IndexEntries
}

/// Extracts only ordinary blobs and symlinks from tree or index records.
fn entries(output: String, kind: EntryKind) -> Result(List(String), String) {
  use records <- result.try(paths_from_nul(output))
  list.try_map(records, fn(record) {
    use #(metadata, path) <- result.try(
      string.split_once(record, "\t")
      |> result.replace_error("malformed repository inventory"),
    )
    let parts = string.split(metadata, " ")

    // Gitlinks and nonzero index stages cannot be represented by this slice.
    use Nil <- result.try(case kind, parts {
      IndexEntries, [mode, _, "0"] | TreeEntries, [mode, "blob", _] ->
        case mode == "100644" || mode == "100755" || mode == "120000" {
          True -> Ok(Nil)
          False -> Error("unsupported Git entry mode")
        }
      _, _ -> Error("unsupported unmerged or non-blob Git entry")
    })

    validate_path(path)
  })
}

/// Requires a complete NUL-framed list and validates every path it carries.
fn paths_from_nul(output: String) -> Result(List(String), String) {
  use paths <- result.try(nul_fields(output))
  list.try_map(paths, validate_path)
}

/// Requires a complete NUL-framed list without interpreting its fields.
fn nul_fields(output: String) -> Result(List(String), String) {
  // Empty output is the valid empty inventory.
  case output {
    "" -> Ok([])
    _ -> {
      // A missing terminator could mean the helper truncated the stream.
      use Nil <- result.try(case string.ends_with(output, "\u{0}") {
        True -> Ok(Nil)
        False -> Error("truncated repository inventory")
      })

      string.drop_end(output, 1)
      |> string.split("\u{0}")
      |> Ok
    }
  }
}

/// Refuses path components that can escape the working tree.
fn validate_path(path: String) -> Result(String, String) {
  let components = string.split(path, "/")

  // Every entry must be a nonempty relative path with ordinary components.
  case
    path != ""
    && !list.any(components, fn(part) {
      part == "" || part == "." || part == ".."
    })
  {
    True -> Ok(path)
    False -> Error("invalid repository inventory path")
  }
}

fn runtime_path(path: String) -> Bool {
  path == ".codemode" || string.starts_with(path, ".codemode/")
}

/// Discovers source metadata under the caller's unchanged parent policy.
///
/// The call's staging path must be an existing nonsecret scratch directory.
/// Metadata paths are accepted only if the original policy permits reading
/// them; a linked worktree's Git pointer does not grant extra authority.
///
/// ## Examples
///
/// ```gleam
/// // repository_snapshot.discover(git, discovery_call, 30_000)
/// ```
@internal
pub fn discover(
  git: worktree_git.Git,
  call: worktree_git.Capture,
  within_ms: Int,
) -> Result(Source, String) {
  let deadline = bootstrap.monotonic_time_ms() + within_ms
  let query =
    worktree_git.Capture(
      ..call,
      arguments: [
        "rev-parse", "--path-format=absolute", "--show-toplevel",
        "--absolute-git-dir", "--git-common-dir", "--show-object-format",
      ],
      context: worktree_git.SourceContext,
      stdin: <<>>,
    )
  use metadata <- result.try(git_text(git, query, deadline))

  // A newline in a path makes this non-NUL Git response ambiguous.
  use #(workspace, git_dir, common_dir, object_format) <- result.try(
    case string.split(string.trim(metadata), "\n") {
      [workspace, git_dir, common_dir, format] ->
        Ok(#(workspace, git_dir, common_dir, format))
      _ -> Error("ambiguous repository metadata")
    },
  )

  use _ <- result.try(
    private_source_paths(call.scope, call.directory, [
      workspace,
      git_dir,
      common_dir,
    ]),
  )

  // A promisor must not fetch while resolving an unavailable HEAD commit.
  use Nil <- result.try(refuse_partial_configuration(git, query, deadline))

  // Verify a commit exists; an unborn or incomplete HEAD is refused.
  use head <- result.try(git_text(
    git,
    worktree_git.Capture(..query, arguments: [
      "rev-parse", "--verify", "HEAD^{commit}",
    ]),
    deadline,
  ))
  let head = string.trim(head)

  // Only object formats supported by Git's destination initialization pass.
  case object_format == "sha1" || object_format == "sha256" {
    True -> Ok(Source(workspace, git_dir, common_dir, object_format, head))
    False -> Error("unsupported Git object format")
  }
}

/// Refuses a warning when Git cannot reliably apply source ignore rules.
fn untracked_text(
  git: worktree_git.Git,
  call: worktree_git.Capture,
  deadline: Int,
) -> Result(String, String) {
  use output <- result.try(git_output(git, call, deadline))

  // Git can exit successfully even when an excludes file was unreadable.
  use Nil <- result.try(case bit_array.byte_size(output.stderr) {
    0 -> Ok(Nil)
    _ -> Error("repository ignore rules could not be evaluated reliably")
  })

  bit_array.to_string(output.stdout)
  |> result.replace_error("repository metadata is not UTF-8")
}

/// Runs one source discovery query within the common monotonic deadline.
fn git_text(
  git: worktree_git.Git,
  call: worktree_git.Capture,
  deadline: Int,
) -> Result(String, String) {
  use output <- result.try(git_output(git, call, deadline))
  bit_array.to_string(output.stdout)
  |> result.replace_error("repository metadata is not UTF-8")
}

/// Applies fixed Git safeguards and returns only a complete successful result.
fn git_output(
  git: worktree_git.Git,
  call: worktree_git.Capture,
  deadline: Int,
) -> Result(worktree_git.BinaryOutput, String) {
  use output <- result.try(git_capture(git, call, deadline))

  // A failed query cannot supply a partial inventory.
  use Nil <- result.try(case output.code {
    0 -> Ok(Nil)
    _ -> Error("repository metadata query failed")
  })

  Ok(output)
}

/// Runs one query under the fixed safeguards and answers however Git exited,
/// for the few questions whose nonzero exit is an answer and not a failure.
fn git_capture(
  git: worktree_git.Git,
  call: worktree_git.Capture,
  deadline: Int,
) -> Result(worktree_git.BinaryOutput, String) {
  // Repository configuration must never start hooks during a read or write.
  let safe =
    worktree_git.Capture(..call, arguments: [
      "--no-replace-objects",
      "-c",
      "core.fsmonitor=false",
      "-c",
      "core.hooksPath=/dev/null",
      "-c",
      "pack.threads=1",
      "-c",
      "pack.windowMemory=64m",
      "-c",
      "pack.deltaCacheSize=32m",
      "-c",
      "gc.auto=0",
      "-c",
      "maintenance.auto=false",
      ..call.arguments
    ])
  worktree_git.run_capture(git, safe, deadline - bootstrap.monotonic_time_ms())
}

/// Resolves metadata identities and checks them against the original policy.
fn private_source_paths(
  scope: policy.SandboxPolicy,
  expected: String,
  paths: List(String),
) -> Result(Nil, String) {
  // The selected working tree must be exactly the caller's workspace.
  use Nil <- result.try(case paths {
    [workspace, ..] if workspace == expected -> Ok(Nil)
    _ -> Error("repository working root differs from the authorized workspace")
  })

  list.try_each(paths, fn(path) {
    // Do not resolve a Git-supplied path before checking its parent grant.
    use Nil <- result.try(
      case
        !list.contains(string.split(path, "/"), "..")
        && list.any(scope.readable_roots, fn(root) {
          policy.covers(root:, path:)
        })
        && !list.any(scope.protected, fn(mask) {
          policy.covers(root: mask, path:)
        })
      {
        True -> Ok(Nil)
        False -> Error("repository metadata is outside its authorized scope")
      },
    )

    use canonical <- result.try(
      bootstrap.canonical_directory(path)
      |> result.replace_error("repository metadata path cannot be resolved"),
    )

    // A symlink spelling cannot establish the metadata identity.
    case canonical == path {
      True -> Ok(Nil)
      False -> Error("repository metadata path is not canonical")
    }
  })
}

/// Narrows a previously authorized session policy for private Git staging.
///
/// All paths must already be canonical directories. The staging directory is
/// a server-created child of the store, and the store mask is the only mask
/// removed. The Git runner grants that one directory separately; its siblings
/// are absent from the resulting readable roots. No mounts survive narrowing.
///
/// ## Examples
///
/// ```gleam
/// // repository_snapshot.private_scope(parent, workspace, git_dir, common_dir, store, stage)
/// ```
@internal
pub fn private_scope(
  parent: policy.SandboxPolicy,
  workspace: String,
  git_dir: String,
  common_dir: String,
  store: String,
  stage: String,
) -> Result(policy.SandboxPolicy, String) {
  let roots = [workspace, git_dir, common_dir]
  let paths = [store, stage, ..roots]
  use Nil <- result.try(
    list.try_each(paths, fn(path) {
      use canonical <- result.try(bootstrap.canonical_directory(path))

      // Paths entering the narrowed scope must name their actual directories.
      case canonical == path {
        True -> Ok(Nil)
        False -> Error("snapshot path is not canonical")
      }
    }),
  )

  // A stage must be inside the private store, never the store itself.
  use Nil <- result.try(
    case
      store != stage
      && policy.covers(root: store, path: stage)
      && list.contains(parent.protected, store)
    {
      True -> Ok(Nil)
      False -> Error("snapshot stage is outside its protected store")
    },
  )

  // A discovered Git path is not itself a grant to read that path.
  use Nil <- result.try(
    case
      list.all(roots, fn(path) {
        list.any(parent.readable_roots, fn(root) { policy.covers(root:, path:) })
        && !overlaps(path, store)
      })
    {
      True -> Ok(Nil)
      False -> Error("snapshot source is outside its authorized scope")
    },
  )

  let protected = list.filter(parent.protected, fn(path) { path != store })

  // Keep every other mask; a masked descendant is checked per selected path.
  use Nil <- result.try(
    case
      list.any(protected, fn(mask) {
        overlaps(stage, mask)
        || list.any(roots, fn(root) { policy.covers(root: mask, path: root) })
      })
    {
      True -> Error("snapshot source or stage overlaps protected state")
      False -> Ok(Nil)
    },
  )

  Ok(
    policy.SandboxPolicy(
      ..parent,
      readable_roots: roots,
      writable_roots: [],
      protected:,
      mounts: [],
      network: policy.NetworkOff,
    ),
  )
}

// Either direction overlaps: a mask inside a granted root matters too.
fn overlaps(left: String, right: String) -> Bool {
  policy.covers(root: left, path: right)
  || policy.covers(root: right, path: left)
}

/// Checks a canonical private staging directory for available disk space.
///
/// The caller supplies only a server-generated directory beneath the private
/// store and computes the conservative required size before calling this.
/// A failed, ambiguous, or insufficient reading refuses admission.
///
/// ## Examples
///
/// ```gleam
/// // repository_snapshot.check_space(stage, 1_073_741_824)
/// ```
@internal
pub fn check_space(stage: String, required_bytes: Int) -> Result(Nil, String) {
  use canonical <- result.try(bootstrap.canonical_directory(stage))

  // Reject aliases and meaningless reservations before the host query.
  use Nil <- result.try(case canonical == stage && required_bytes > 0 {
    True -> Ok(Nil)
    False -> Error("invalid snapshot staging space request")
  })

  // Only a fixed operating-system utility receives the canonical directory.
  use executable <- result.try(case ffi_os.platform() {
    #("darwin", _) -> Ok("/bin/df")
    #("linux", _) -> Ok("/usr/bin/df")
    _ -> Error("snapshot disk space is unavailable on this platform")
  })

  use #(code, output) <- result.try(
    ffi_os.run_capture(
      "/usr/bin/env",
      ["LC_ALL=C", executable, "-Pk", stage],
      5000,
    )
    |> result.replace_error("snapshot disk space query failed"),
  )

  // An incomplete or oversized result cannot justify admission.
  use available <- result.try(
    case code == 0 && string.byte_size(output) <= 8192 {
      True -> available_bytes(output)
      False -> Error("snapshot disk space query failed")
    },
  )

  // The reading is an observation, not a reservation.
  case available >= required_bytes {
    True -> Ok(Nil)
    False -> Error("insufficient space for repository snapshot")
  }
}

/// POSIX df prints one heading and one filesystem row for one path. The
/// filesystem or mount name containing spaces makes the row ambiguous, so
/// refuse it instead of guessing which field holds the available blocks.
fn available_bytes(output: String) -> Result(Int, String) {
  let lines =
    string.split(string.trim(output), "\n")
    |> list.map(string.trim)

  // One path must produce exactly one row under the fixed C locale.
  use row <- result.try(case lines {
    [header, row] ->
      case string.starts_with(header, "Filesystem") {
        True -> Ok(row)
        False -> Error("unrecognized snapshot disk space output")
      }
    _ -> Error("unrecognized snapshot disk space output")
  })

  let fields =
    row
    |> string.replace("\t", " ")
    |> string.split(" ")
    |> list.filter(fn(field) { field != "" })

  // The numeric fields must all occupy their standard positions.
  use available <- result.try(
    case fields {
      [_, total, used, available, capacity, _] -> {
        use _ <- result.try(int.parse(total) |> result.replace_error(Nil))
        use _ <- result.try(int.parse(used) |> result.replace_error(Nil))
        use available <- result.try(int.parse(available))
        use percent <- result.try(string.drop_end(capacity, 1) |> int.parse)

        // The fixed C output must contain a nonnegative percentage and size.
        case available >= 0 && percent >= 0 && string.ends_with(capacity, "%") {
          True -> Ok(available)
          False -> Error(Nil)
        }
      }
      _ -> Error(Nil)
    }
    |> result.replace_error("unrecognized snapshot disk space output"),
  )
  Ok(available * 1024)
}
