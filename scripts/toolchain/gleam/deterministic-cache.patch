 }
+
+/// Serialize set members in a stable order without changing their in-memory hashing.
+pub fn ordered_set<S, T>(value: &HashSet<T>, serializer: S) -> Result<S::Ok, S::Error>
+where
+    S: serde::Serializer,
+    T: serde::Serialize + Ord,
+{
+    use serde::Serialize;
+    let ordered: std::collections::BTreeSet<_> = value.iter().collect();
+    ordered.serialize(serializer)
+}
+
+/// Preserve variant order while serializing each variant's field map by label.
+pub fn ordered_maps<S, K, V>(values: &[HashMap<K, V>], serializer: S) -> Result<S::Ok, S::Error>
+where
+    S: serde::Serializer,
+    K: serde::Serialize + Ord,
+    V: serde::Serialize,
+{
+    use serde::Serialize;
+    let ordered: Vec<std::collections::BTreeMap<_, _>> =
+        values.iter().map(|value| value.iter().collect()).collect();
+    ordered.serialize(serializer)
+}
