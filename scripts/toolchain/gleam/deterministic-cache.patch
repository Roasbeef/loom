+#[test]
+fn deterministic_cache_inline_functions() {
+    // Exercise both the parameter membership list and labelled decision trees.
+    for source in [
+        "pub fn guard(when condition: Bool, return consequence: a, otherwise alternative: fn() -> a) -> a { case condition { True -> consequence False -> alternative() } }",
+        "pub type Thing { Thing(first: Int, second: Int, third: Int) } pub fn guard(value: Thing) -> Thing { case value { Thing(a, b, c) -> Thing(a, b, c) } }",
+    ] {
+        let compile = || {
+            let mut module = type_::tests::compile_module("gleam/bool", source, None, vec![])
+                .expect("inline fixture must compile");
+            let function = crate::inline::function_to_inlinable(
+                "gleam_stdlib",
+                "gleam/bool",
+                &module.definitions.functions[0],
+            )
+            .expect("fixture must exercise cached inlining");
+            _ = module
+                .type_info
+                .inline_functions
+                .insert("guard".into(), function);
+            encode(&module.type_info).unwrap()
+        };
+        let expected = compile();
+        for _ in 0..32 {
+            assert!(expected == compile(), "inline cache must have stable bytes");
+        }
+    }
+}
+
+#[test]
+fn deterministic_cache_for_equivalent_maps() {
+    let make_module = || {
+        let mut module = constant_module(Constant::Int {
+            location: SrcSpan::default(),
+            value: "1".into(),
+            int_value: 1.into(),
+        });
+        let value = module.values.values().next().unwrap().clone();
+        module.values = (0..64)
+            .map(|index| (format!("value_{index}").into(), value.clone()))
+            .collect();
+        module.line_numbers = LineNumbers::new("éα🦀漢字\néα🦀漢字");
+        module.references.imported_modules = (0..64)
+            .map(|index| format!("module_{index}").into())
+            .collect();
+        module
+    };
+    let first = make_module();
+    let expected = encode(&first).unwrap();
+    for _ in 0..16 {
+        let next = make_module();
+        assert_eq!(first, next);
+        assert!(
+            expected == encode(&next).unwrap(),
+            "equivalent cache data must have identical bytes"
+        );
+        assert_eq!(roundtrip(&next), next);
+    }
+}
