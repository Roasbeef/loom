+#[test]
+fn deterministic_cache_for_equivalent_maps() {
+    let make_module = || {
+        let mut module = constant_module(Constant::Int {
+            location: SrcSpan::default(),
+            value: "1".into(),
+            int_value: 1.into(),
+        });
+        let value = module.values.values().next().unwrap().clone();
+        module.values = (0..64)
+            .map(|index| (format!("value_{index}").into(), value.clone()))
+            .collect();
+        module.line_numbers = LineNumbers::new("éα🦀漢字\néα🦀漢字");
+        module.references.imported_modules = (0..64)
+            .map(|index| format!("module_{index}").into())
+            .collect();
+        module
+    };
+    let first = make_module();
+    let expected = encode(&first).unwrap();
+    for _ in 0..16 {
+        let next = make_module();
+        assert_eq!(first, next);
+        assert!(
+            expected == encode(&next).unwrap(),
+            "equivalent cache data must have identical bytes"
+        );
+        assert_eq!(roundtrip(&next), next);
+    }
+}
+
+#[test]
+fn deterministic_cache_type_ids_after_loading() {
+    let mut module = constant_module(Constant::Int {
+        location: SrcSpan::default(),
+        value: "1".into(),
+        int_value: 1.into(),
+    });
+    module.types = (0..64)
+        .map(|index| {
+            let parameter = type_::generic_var(100 + index);
+            (
+                format!("Type{index}").into(),
+                TypeConstructor {
+                    type_: type_::tuple(vec![parameter.clone(), parameter.clone()]),
+                    publicity: Publicity::Public,
+                    origin: SrcSpan::default(),
+                    module: "a".into(),
+                    parameters: vec![parameter],
+                    deprecation: Deprecation::NotDeprecated,
+                    documentation: None,
+                },
+            )
+        })
+        .collect();
+    let bytes = encode(&module).unwrap();
+    let decode_fresh = || decode(&bytes, UniqueIdGenerator::new()).unwrap();
+    let expected = encode(&decode_fresh()).unwrap();
+    for _ in 0..16 {
+        let decoded = decode_fresh();
+        assert!(
+            expected == encode(&decoded).unwrap(),
+            "cache loads must allocate stable type IDs"
+        );
+        for constructor in decoded.types.values() {
+            assert_eq!(
+                constructor.type_,
+                type_::tuple(vec![constructor.parameters[0].clone(); 2])
+            );
+        }
+    }
+}
