+#[test]
+fn deterministic_cache_package_manifest() {
+    let make_packages = || LocalPackages {
+        packages: (0..64)
+            .map(|index| (format!("package_{index}").into(), Version::new(1, 0, 0)))
+            .collect(),
+        git: (0..64)
+            .map(|index| {
+                (
+                    format!("git_package_{index}").into(),
+                    GitState {
+                        commit: format!("commit_{index}").into(),
+                        path: Some(format!("packages/package_{index}").into()),
+                    },
+                )
+            })
+            .collect(),
+    };
+    let expected = toml::to_string(&make_packages()).unwrap();
+    for _ in 0..16 {
+        let packages = make_packages();
+        let encoded = toml::to_string(&packages).unwrap();
+        assert_eq!(expected, encoded);
+        assert_eq!(packages, toml::from_str::<LocalPackages>(&encoded).unwrap());
+    }
+}
