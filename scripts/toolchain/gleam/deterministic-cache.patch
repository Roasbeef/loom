+// Diagnostic names are part of cached warnings, so their maps need the same
+// stable serialized order as the module interface containing them.
+fn ordered_im_map<S, K, V>(value: &HashMap<K, V>, serializer: S) -> Result<S::Ok, S::Error>
+where
+    S: serde::Serializer,
+    K: serde::Serialize + Ord + Clone + std::hash::Hash,
+    V: serde::Serialize + Clone,
+{
+    use serde::Serialize;
+    let ordered: std::collections::BTreeMap<_, _> = value.iter().collect();
+    ordered.serialize(serializer)
+}
+
+fn ordered_bimap<S, K, V>(value: &BiMap<K, V>, serializer: S) -> Result<S::Ok, S::Error>
+where
+    S: serde::Serializer,
+    K: serde::Serialize + Ord + std::hash::Hash,
+    V: serde::Serialize + Eq + std::hash::Hash,
+{
+    use serde::Serialize;
+    let ordered: std::collections::BTreeMap<_, _> = value.iter().collect();
+    ordered.serialize(serializer)
+}
