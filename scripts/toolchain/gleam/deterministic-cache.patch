+#[test]
+fn deterministic_cache_diagnostic_names() {
+    let make_names = || Names {
+        local_types: (0..64)
+            .map(|i| {
+                (
+                    ("module".into(), eco_format!("Type{i}")),
+                    eco_format!("Alias{i}"),
+                )
+            })
+            .collect(),
+        imported_modules: (0..64)
+            .map(|i| {
+                (
+                    eco_format!("module_{i}"),
+                    (eco_format!("alias_{i}"), SrcSpan::default()),
+                )
+            })
+            .collect(),
+        type_variables: (0..64).map(|i| (i, eco_format!("var_{i}"))).collect(),
+        local_value_constructors: (0..64)
+            .map(|i| {
+                (
+                    ("module".into(), eco_format!("Value{i}")),
+                    eco_format!("Local{i}"),
+                )
+            })
+            .collect(),
+        reexport_aliases: (0..64)
+            .map(|i| {
+                (
+                    ("module".into(), eco_format!("Type{i}")),
+                    ("other".into(), eco_format!("Alias{i}")),
+                )
+            })
+            .collect(),
+    };
+    let config = bincode::config::legacy();
+    let expected = bincode::serde::encode_to_vec(make_names(), config).unwrap();
+    for _ in 0..16 {
+        let names = make_names();
+        let bytes = bincode::serde::encode_to_vec(&names, config).unwrap();
+        assert!(
+            expected == bytes,
+            "cached diagnostic names must have stable bytes"
+        );
+        let (decoded, read): (Names, usize) =
+            bincode::serde::decode_from_slice(&bytes, config).unwrap();
+        assert_eq!(names, decoded);
+        assert_eq!(read, bytes.len());
+    }
+}
