+// Diagnostic names are part of cached warnings, so their maps need the same
+// stable serialized order as the module interface containing them.
+fn ordered_im_map<S, K, V>(value: &HashMap<K, V>, serializer: S) -> Result<S::Ok, S::Error>
+where
+    S: serde::Serializer,
+    K: serde::Serialize + Ord + Clone + std::hash::Hash,
+    V: serde::Serialize + Clone,
+{
+    use serde::Serialize;
+    let ordered: std::collections::BTreeMap<_, _> = value.iter().collect();
+    ordered.serialize(serializer)
+}
+
+fn ordered_bimap<S, K, V>(value: &BiMap<K, V>, serializer: S) -> Result<S::Ok, S::Error>
+where
+    S: serde::Serializer,
+    K: serde::Serialize + Ord + std::hash::Hash,
+    V: serde::Serialize + Eq + std::hash::Hash,
+{
+    use serde::Serialize;
+    let ordered: std::collections::BTreeMap<_, _> = value.iter().collect();
+    ordered.serialize(serializer)
+}
+
+#[test]
+fn deterministic_cache_diagnostic_names() {
+    let make_names = || Names {
+        local_types: (0..64)
+            .map(|i| {
+                (
+                    ("module".into(), eco_format!("Type{i}")),
+                    eco_format!("Alias{i}"),
+                )
+            })
+            .collect(),
+        imported_modules: (0..64)
+            .map(|i| {
+                (
+                    eco_format!("module_{i}"),
+                    (eco_format!("alias_{i}"), SrcSpan::default()),
+                )
+            })
+            .collect(),
+        type_variables: (0..64).map(|i| (i, eco_format!("var_{i}"))).collect(),
+        local_value_constructors: (0..64)
+            .map(|i| {
+                (
+                    ("module".into(), eco_format!("Value{i}")),
+                    eco_format!("Local{i}"),
+                )
+            })
+            .collect(),
+        reexport_aliases: (0..64)
+            .map(|i| {
+                (
+                    ("module".into(), eco_format!("Type{i}")),
+                    ("other".into(), eco_format!("Alias{i}")),
+                )
+            })
+            .collect(),
+    };
+    let expected = bitcode::serialize(&make_names()).unwrap();
+    for _ in 0..16 {
+        let names = make_names();
+        let bytes = bitcode::serialize(&names).unwrap();
+        assert!(
+            expected == bytes,
+            "cached diagnostic names must have stable bytes"
+        );
+        let decoded: Names = bitcode::deserialize(&bytes).unwrap();
+        assert_eq!(names, decoded);
+    }
+}
