+#[test]
+fn provided_native_dependency_preserves_its_builder() {
+    let source = ProvidedPackageSource::Git {
+        repo: "https://example.com/native.git".into(),
+        commit: "0123456789012345678901234567890123456789".into(),
+        path: None,
+    };
+    let native = ProvidedPackage {
+        version: Version::new(1, 0, 0),
+        build_tool: PackageBuildTool::Rebar3,
+        source,
+        requirements: HashMap::new(),
+    };
+    let manifest = native.to_manifest_package("native");
+    assert_eq!(manifest.build_tools, vec![EcoString::from("rebar3")]);
+    assert_eq!(manifest.source, native.source.to_manifest_package_source());
+    let gleam = ProvidedPackage {
+        build_tool: PackageBuildTool::Gleam,
+        ..native
+    };
+    assert_eq!(
+        gleam.to_manifest_package("native").build_tools,
+        vec![EcoString::from("gleam")]
+    );
+}
+
+#[test]
+fn changed_git_commit_retires_native_build_at_same_version() {
+    let mut package = ManifestPackage {
+        name: "native".into(),
+        version: Version::new(1, 0, 0),
+        build_tools: vec!["rebar3".into()],
+        otp_app: None,
+        requirements: vec![],
+        source: ManifestPackageSource::Git {
+            repo: "https://example.com/native.git".into(),
+            commit: "old".into(),
+            path: None,
+        },
+    };
+    let old = Manifest {
+        packages: vec![package.clone()],
+        requirements: HashMap::new(),
+    };
+    let local = LocalPackages::from_manifest(&old);
+    assert!(local.extra_local_packages(&old).is_empty());
+    package.source = ManifestPackageSource::Git {
+        repo: "https://example.com/native.git".into(),
+        commit: "new".into(),
+        path: None,
+    };
+    let updated = Manifest {
+        packages: vec![package],
+        requirements: HashMap::new(),
+    };
+    assert_eq!(
+        local.extra_local_packages(&updated),
+        vec![(EcoString::from("native"), Version::new(1, 0, 0))]
+    );
+}
