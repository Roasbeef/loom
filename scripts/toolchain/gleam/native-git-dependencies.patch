+#[test]
+fn provided_dependency_build_tool() {
+    let default: PackageConfig = toml::from_str("name = \"sample\"").unwrap();
+    assert_eq!(default.build_tool, PackageBuildTool::Gleam);
+    let native: PackageConfig =
+        toml::from_str("name = \"sample\"\nbuild_tool = \"rebar3\"").unwrap();
+    assert_eq!(native.build_tool, PackageBuildTool::Rebar3);
+    let encoded = serde_json::to_string(&native).unwrap();
+    let decoded: PackageConfig = serde_json::from_str(&encoded).unwrap();
+    assert_eq!(decoded.build_tool, PackageBuildTool::Rebar3);
+    assert!(
+        toml::from_str::<PackageConfig>("name = \"sample\"\nbuild_tool = \"unknown\"").is_err()
+    );
+}
